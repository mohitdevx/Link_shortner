# ==============================================================================
# Application Server Configuration
# ==============================================================================
# Port on which the backend container/service will be exposed
PORT=5000

# Runtime environment (development | production | test)
NODE_ENV=development

# ==============================================================================
# Security & Authentication
# ==============================================================================
# Strong secret key for signing and verifying JWT tokens
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_12345

# ==============================================================================
# MongoDB Database Configuration (Docker Compose)
# ==============================================================================
# Root credentials used to initialize the MongoDB container
MONGO_INITDB_ROOT_USERNAME=admin_user
MONGO_INITDB_ROOT_PASSWORD=strong_mongo_password_123

# Connection URI for backend to communicate with MongoDB inside Docker network
# Format: mongodb://<username>:<password>@mongodb:27017/<database>?authSource=admin
MONGO_URI=mongodb://admin_user:strong_mongo_password_123@mongodb:27017/LinkShortener?authSource=admin

# ==============================================================================
# Redis In-Memory Cache & Analytics
# ==============================================================================
# Authentication password for the Redis container
REDIS_PASSWORD=strong_redis_password_123
