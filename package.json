{
  "name": "link-shortener-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:pnpm": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"pnpm --prefix backend dev\" \"pnpm --prefix frontend dev\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "npm start --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
